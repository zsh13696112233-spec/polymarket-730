NEXT_PUBLIC_API_BASE=http://127.0.0.1:8730
# 默认隐藏全部页面信息；设为 0 恢复。修改后重启前端，生产环境需重新构建。
NEXT_PUBLIC_HIDE_SYSTEM_INFO=1
# 内网访问时，将 API 地址改为 http://服务器内网IP:8730，并在下方填写 http://服务器内网IP:3000
POLYMARKET_CORS_ORIGINS=
POLYMARKET_DATABASE_URL=sqlite+aiosqlite:///./data/polymarket-watch.db
POLYMARKET_TRADING_ENABLED=1
POLYMARKET_PROXY_URL=http://127.0.0.1:7897
POLYMARKET_DATA_API_CONCURRENCY=10
POLYMARKET_GAMMA_API_CONCURRENCY=6
POLYMARKET_CLOB_API_CONCURRENCY=10
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_RELAYER_API_URL=https://relayer-v2.polymarket.com
POLYMARKET_POLYGON_RPC_URL=https://polygon.drpc.org
POLYMARKET_WHALE_ENABLED=1
POLYMARKET_WHALE_SCAN_INTERVAL_SECONDS=60
POLYMARKET_WHALE_MAX_SCAN_PAGES=20
POLYMARKET_WHALE_PROFILE_BATCH_LIMIT=50
POLYMARKET_SMTP_HOST=
POLYMARKET_SMTP_PORT=587
POLYMARKET_SMTP_USERNAME=
POLYMARKET_SMTP_PASSWORD=
POLYMARKET_SMTP_FROM_EMAIL=
POLYMARKET_SMTP_FROM_NAME=PolyCopy
POLYMARKET_SMTP_SECURITY=starttls

# 自动跟单周报：北京时间每周一 06:00；逗号分隔收件邮箱，留空关闭。
POLYMARKET_WEEKLY_REPORT_TO=
